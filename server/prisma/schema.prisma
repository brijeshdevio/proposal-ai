generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String

  sessions   Session[]
  profile    Profile?
  proposals  Proposal[]
  aiSessions AiSession[]

  role Role @default(user)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Session {
  id     String @id @default(cuid())
  userId String

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String @id @default(cuid())
  sessionId String

  tokenHash String @unique

  expiresAt DateTime
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model Proposal {
  id             String @id @default(uuid())
  userId         String
  title          String
  jobDescription String
  tone           String
  currency       String
  aiResponse     Json
  tokensUsed     Int

  user      User       @relation(fields: [userId], references: [id])
  aiSession AiSession?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model AiSession {
  id         String @id @default(uuid())
  userId     String
  proposalId String @unique

  promptSent String
  aiResponse String
  tokensUsed Int
  model      String
  durationMs Int

  user     User     @relation(fields: [userId], references: [id])
  proposal Proposal @relation(fields: [proposalId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([proposalId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([model])
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique

  skills          String[]
  experienceYears Int      @default(0)
  defaultRateINR  Float?
  defaultRateUSD  Float?
  bio             String?

  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt

  @@index([experienceYears])
}

enum Role {
  user
  admin
}
